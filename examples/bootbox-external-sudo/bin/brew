#!/bin/bash
set -euo pipefail

example_dir="$(cd "$(dirname "$0")/.." && pwd)"
prefix="/private/var/root/bootbox-homebrew-prefix"

case "${1:-}" in
  --version)
    printf "Homebrew 9.9.9\n"
    ;;
  --prefix)
    printf "%s\n" "$prefix"
    ;;
  shellenv)
    printf "export HOMEBREW_PREFIX=%q\n" "$prefix"
    printf "export PATH=%q:\"\$PATH\"\n" "$example_dir/bin"
    ;;
  list)
    exit 0
    ;;
  bundle)
    case "${2:-}" in
      check)
        if [[ "${EXAMPLE_BREW_CASE:-}" == "install" ]]; then
          exit 1
        fi
        ;;
      install)
        ;;
    esac
    ;;
  *)
    exit 0
    ;;
esac
